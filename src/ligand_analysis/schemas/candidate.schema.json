{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate row",
  "description": "Eligible labelled ligand for the receptor; 'selected' marks the demo subset.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ligand_id", "receptor_id", "label", "class_name", "selected", "name", "approved", "smiles",
               "inchikey", "connectivity_key", "pubchem_cid", "original_terms", "n_annotations"],
  "properties": {
    "ligand_id": {"type": "string", "pattern": "^iuphar\\.ligand:[0-9]+$"},
    "receptor_id": {"type": "string", "minLength": 1},
    "label": {"type": "integer", "enum": [0, 1]},
    "class_name": {"type": "string", "enum": ["agonist", "antagonist"]},
    "selected": {"type": "boolean"},
    "selection_rank": {"type": ["integer", "null"], "minimum": 1, "description": "Rank within the class when selected."},
    "selection_note": {"type": ["string", "null"]},
    "name": {"type": "string"},
    "approved": {"type": "boolean"},
    "smiles": {"type": "string", "minLength": 1},
    "inchikey": {"type": "string", "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$"},
    "connectivity_key": {"type": "string", "pattern": "^[A-Z]{14}$"},
    "pubchem_cid": {"type": ["integer", "null"], "minimum": 1},
    "chembl_id": {"type": ["string", "null"]},
    "original_terms": {"type": "string", "minLength": 1, "description": "GtoPdb 'Type / Action' terms, semicolon separated."},
    "pubmed_ids": {"type": ["string", "null"], "pattern": "^[0-9]+(\\|[0-9]+)*$"},
    "n_annotations": {"type": "integer", "minimum": 1}
  }
}
