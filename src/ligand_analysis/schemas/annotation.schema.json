{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Annotation row",
  "description": "One GtoPdb interaction for the receptor, with original terms and the mapped label.",
  "type": "object",
  "additionalProperties": false,
  "required": ["annotation_id", "ligand_id", "receptor_id", "source_release", "target_species", "original_type",
               "original_action", "label_status", "pair_status", "endogenous", "primary_target"],
  "properties": {
    "annotation_id": {"type": "string", "pattern": "^gtopdb:[0-9a-f]{16}$", "description": "Hash of the raw source row."},
    "ligand_id": {"type": "string", "pattern": "^iuphar\\.ligand:[0-9]+$"},
    "receptor_id": {"type": "string", "minLength": 1},
    "source_release": {"type": "string", "minLength": 1},
    "target_species": {"type": "string"},
    "original_type": {"type": "string"},
    "original_action": {"type": "string"},
    "action_comment": {"type": ["string", "null"]},
    "label": {"type": ["integer", "null"], "enum": [0, 1, null]},
    "label_status": {"type": "string", "enum": ["mapped", "unmapped"]},
    "pair_status": {"type": "string", "enum": ["consistent", "ambiguous", "conflicting", "unmapped"],
                    "description": "Over all annotations of this ligand-receptor pair."},
    "selectivity": {"type": ["string", "null"]},
    "endogenous": {"type": "boolean"},
    "primary_target": {"type": "boolean"},
    "affinity_units": {"type": ["string", "null"]},
    "affinity_low": {"type": ["string", "null"]},
    "affinity_median": {"type": ["string", "null"]},
    "affinity_high": {"type": ["string", "null"]},
    "assay_description": {"type": ["string", "null"]},
    "receptor_site": {"type": ["string", "null"]},
    "ligand_context": {"type": ["string", "null"]},
    "pubmed_ids": {"type": ["string", "null"], "pattern": "^[0-9]+(\\|[0-9]+)*$"}
  }
}
