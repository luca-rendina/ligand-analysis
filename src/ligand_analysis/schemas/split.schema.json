{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Split assignment",
  "description": "Persisted train/test assignment of a labelled ligand, shared by every representation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ligand_id", "receptor_id", "group_id", "label", "class_name", "partition"],
  "properties": {
    "ligand_id": {"type": "string", "minLength": 1},
    "receptor_id": {"type": "string", "minLength": 1},
    "group_id": {"type": "string", "minLength": 1},
    "label": {"type": "integer", "enum": [0, 1]},
    "class_name": {"enum": ["agonist", "antagonist"]},
    "partition": {"enum": ["train", "test"]}
  }
}
