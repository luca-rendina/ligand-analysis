{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ligand input row",
  "description": "Molecular identity to prepare, dock and featurize. Carries no pharmacology label.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ligand_id", "smiles"],
  "properties": {
    "ligand_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "name": {"type": ["string", "null"]},
    "smiles": {"type": "string", "minLength": 1},
    "inchikey": {"type": ["string", "null"], "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$"}
  }
}
