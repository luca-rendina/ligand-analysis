// Single-node kind execution. Controller and task pods share the same persistent PVC.
params {
    sources_dir = '/workspace/sources'
    outdir = '/workspace/results/adrb2-demo'
    image_manifest = '/workspace/image-manifest.json'
}

workDir = '/workspace/work'

process {
    executor = 'k8s'
    maxForks = 2
}

executor {
    name = 'k8s'
    queueSize = 2
}

podman.enabled = false

k8s {
    namespace = 'ligand-analysis'
    serviceAccount = 'workflow-worker'
    storageClaimName = 'ligand-analysis-data'
    storageMountPath = '/workspace'
    launchDir = "/workspace/projects/${params.git_revision}"
    workDir = '/workspace/work'
    computeResourceType = 'Job'
    imagePullPolicy = 'Never'
    cpuLimits = true
    cleanup = false
}
