# Files read by Linux tools inside containers keep LF endings in Windows checkouts.
Containerfile text eol=lf
.containerignore text eol=lf
*.lock text eol=lf
*.sh text eol=lf
*.nf text eol=lf
*.config text eol=lf
configs/** text eol=lf
data/manifests/** text eol=lf
deploy/** text eol=lf
# Tests compare curated tables byte for byte with fresh output.
data/curated/** text eol=lf
# Fixed-column molecular fixtures read inside Linux containers.
tests/fixtures/** text eol=lf
