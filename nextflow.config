// Execution settings for the ligand-analysis workflow. Scientific parameters live in the params
// file (configs/demo.yaml); run with -profile podman (see README.md, "Workflow").

manifest {
    name = 'ligand-analysis'
    description = 'Reproducible GPCR agonist/antagonist ligand workflow (public ADRB2 demo)'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.04.0'
}

params {
    manifest = 'data/manifests/adrb2.yaml'
    outdir = 'data/local/results/adrb2-demo'
    // Persistent source snapshots (FETCH storeDir); data/sources/<name> is tracked by DVC.
    sources_dir = 'data/sources'
    git_revision = 'unknown'
    containers {
        ml = 'localhost/ligand-ml:dev'
        chem = 'localhost/ligand-chem:dev'
    }
    max_cpus = 16
    max_memory = '12 GB'
    dock_cpus = 2
}

workDir = 'data/local/work'

process {
    cpus = 1
    memory = '2 GB'
    errorStrategy = 'terminate'
    withLabel: 'ml' {
        container = params.containers.ml
    }
    withLabel: 'chem' {
        container = params.containers.chem
    }
    withName: 'DOCK|REDOCK_REFERENCE' {
        cpus = params.dock_cpus
    }
}

executor {
    name = 'local'
    cpus = params.max_cpus
    memory = params.max_memory
}

profiles {
    podman {
        includeConfig 'conf/podman.config'
    }
    k8s {
        includeConfig 'conf/k8s.config'
    }
    // No network in any task container (use with podman once the source snapshot exists).
    offline {
        podman.runOptions = '--network=none'
    }
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    fields = 'task_id,hash,name,status,exit,duration,realtime,%cpu,peak_rss,workdir'
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}
